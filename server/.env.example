# Port to listen on
PORT=8080
# Secret used to sign session JWTs. Generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Path to the SQLite database file
DB_PATH=./data/universalsettings.db
# Skip Mojang verification and sign tokens for anyone. LOCAL DEV ONLY —
# the server refuses to start with this set when NODE_ENV=production.
AUTH_DISABLED=false
# caddy domain
DOMAIN=localhost